{
  "rules": {
    "system": {
      "operatorCredentials": {
        ".read": true,
        ".write": "auth != null || !data.exists()"
      }
    },
    "cafeyou": {
      "$storageKey": {
        ".read": true,
        "cafeSettings": {
          ".write": true
        },
        "tableOrders": {
          ".write": true,
          "$orderId": {
            // Tamu diizinkan membuat pesanan baru (insert)
            // Kasir diizinkan mengubah status tiket pesanan atau void/delete
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'tableNumber', 'items', 'totalAmount', 'status', 'createdAt'])"
          }
        },
        "vouchers": {
          ".write": true,
          "$voucherCode": {
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['code', 'tableNumber', 'quotaTotal', 'quotaUsed', 'status'])"
          }
        },
        "tables": {
          ".write": true
        },
        "menuItems": {
          ".write": true
        },
        "queue": {
          ".write": true
        },
        "history": {
          ".write": true
        },
        "songLibrary": {
          ".write": true
        },
        "dailyPin": {
          ".write": true
        },
        "stage_cues": {
          ".write": true
        },
        "expenses": {
          ".write": true
        },
        "runningText": {
          ".write": true
        },
        "playbackStatus": {
          ".write": true
        },
        "volume": {
          ".write": true
        },
        "isMuted": {
          ".write": true
        },
        "forceSkip": {
          ".write": true
        },
        "forceReplay": {
          ".write": true
        },
        "soundEffect": {
          ".write": true
        },
        "liveReaction": {
          ".write": true
        },
        "playerHeartbeat": {
          ".write": true
        },
        "fairRotationEnabled": {
          ".write": true
        },
        "autoSaveLibrary": {
          ".write": true
        }
      },
      "player_session_lock": {
        ".read": true,
        ".write": true
      },
      "assistance_requests": {
        ".read": true,
        ".write": true
      }
    }
  }
}
