{
  "rules": {
    "system": {
      "operatorCredentials": {
        ".read": true,
        ".write": "auth != null || !data.exists()"
      }
    },
    "cafeyou": {
      "$storageKey": {
        ".read": true,
        "tableOrders": {
          ".write": true,
          "$orderId": {
            // Tamu diizinkan membuat pesanan baru (insert)
            // Kasir diizinkan mengubah status tiket pesanan atau void/delete
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'tableNumber', 'items', 'totalAmount', 'status', 'createdAt'])"
          }
        },
        "vouchers": {
          ".write": true,
          "$voucherCode": {
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['code', 'tableNumber', 'quotaTotal', 'quotaUsed', 'status'])"
          }
        },
        "queue": {
          ".write": true
        },
        "history": {
          ".write": true
        },
        "songLibrary": {
          ".write": true
        },
        "dailyPin": {
          ".write": true
        },
        "stage_cues": {
          ".write": true
        },
        "expenses": {
          ".write": true
        }
      },
      "player_session_lock": {
        ".read": true,
        ".write": true
      }
    }
  }
}
